rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    // EDIT: your owner email(s) - same as OWNER_EMAILS in firebase-config.js
    function isOwner() { return signedIn() && me() in ['owner@example.com']; }
    function myRole() {
      return !signedIn() ? 'none'
        : isOwner() ? 'admin'
        : exists(/databases/$(database)/documents/roles/$(me())) ? get(/databases/$(database)/documents/roles/$(me())).data.role
        : 'none';
    }
    function cliRole() { return myRole() in ['admin','manager','cashier','reception']; }
    function invRole() { return myRole() in ['admin','manager','technician']; }
    function staff() { return myRole() in ['admin','reception','technician','manager','cashier']; }
    function active() { return staff() || myRole() == 'guest'; }
    function touches(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // ---------- roles: admins manage, everyone can read their own ----------
    match /roles/{docId} {
      allow get: if signedIn() && (docId == me() || myRole() == 'admin');
      allow list: if myRole() == 'admin';
      allow write: if myRole() == 'admin';
    }

    // ---------- cases ----------
    match /cases/{caseId} {
      allow read: if active();
      allow create: if myRole() in ['admin','reception']
        && request.resource.data.warranty == 'in'
        && request.resource.data.status == 'waiting'
        && request.resource.data.loc == 'reception';
      allow update: if staff()
        && (!touches(['warranty','warrantyLog']) || myRole() in ['admin','technician'])
        && (!touches(['photo','photoDone','repairInfo','parts','cost','tech','startedAt','repairedAt','outcome']) || myRole() in ['admin','technician'])
        && (!touches(['charge']) || myRole() in ['admin','manager','cashier','technician'])
        && (!touches(['expected']) || myRole() in ['admin','technician'])
        && (!touches(['tk','pubSig']) || myRole() in ['admin','reception','technician'])
        && (!touches(['clientId']) || myRole() in ['admin','reception','manager'])
        && (!touches(['partLines','partsTotal']) || invRole())
        && (!touches(['loc','track','returnDate']) || myRole() in ['admin','reception','technician'])
        && (!touches(['status']) || myRole() in ['admin','reception','technician','manager'])
        // a case can only be re-opened while the phone is physically in the workshop
        && !(resource.data.status in ['repaired','delivered','archived'] && request.resource.data.status == 'repairing' && resource.data.loc != 'workshop');
      allow delete: if myRole() == 'admin';
    }

    // ---------- inventory: receiving notes, part lots, stock movements ----------
    match /grn/{noteId} {
      allow read: if invRole();
      allow create: if invRole() && request.resource.data.status == 'draft';
      allow update, delete: if invRole() && resource.data.status == 'draft';   // confirmed notes are closed
    }
    match /parts/{partId} {
      allow read: if invRole();
      allow create: if invRole();
      allow update, delete: if myRole() == 'admin';
    }
    match /stockmoves/{moveId} {
      allow read: if invRole();
      allow create: if invRole();
      allow update, delete: if false;                                         // append-only history
    }

    // ---------- clients and their prepaid accounts ----------
    match /clients/{clientId} {
      allow read: if cliRole();
      allow create, update: if cliRole();
      allow delete: if myRole() == 'admin';
    }
    match /acctx/{txId} {
      allow read: if cliRole();
      allow create: if cliRole();
      allow update, delete: if false;                                         // append-only ledger
    }

    // ---------- public tracking pages (no personal data; customers read by tracking code or phone) ----------
    match /track/{codeId} {
      allow get: if true;
      allow list: if false;
      allow write: if staff();
    }
    match /trackph/{phoneId} {
      allow get: if true;
      allow list: if false;
      allow write: if staff();
    }

    // ---------- shop settings (thresholds, currency, notice): everyone reads, admin writes ----------
    match /settings/{docId} {
      allow read: if active();
      allow write: if myRole() == 'admin';
    }

    // ---------- cash payments ----------
    match /payments/{paymentId} {
      allow read: if myRole() in ['admin','manager','cashier','technician','reception'];
      allow create: if myRole() in ['admin','manager','cashier','reception'];
      allow update: if false;
      allow delete: if myRole() == 'admin';
    }

    // ---------- audit log: append-only, admins read ----------
    match /audit/{entryId} {
      allow read: if myRole() == 'admin';
      allow create: if staff() && request.resource.data.uid == me();
      allow update, delete: if false;
    }
  }
}
